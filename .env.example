# Copy this file to .env and fill in real values. Never commit .env.
# Get the API key from: build.nvidia.com/models → any Nemotron model → "View Code"

# ── NVIDIA API ────────────────────────────────────────────────────────────────
NEMOTRON_API_KEY=nvapi-your-key-here
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Nemotron model IDs ────────────────────────────────────────────────────────
# Safety Reasoning Agent (Kevin) — multi-step reasoning + ReAct loop
NEMOTRON_SUPER_MODEL=nvidia/llama-3_3-nemotron-super-49b-v1_5

# Companion Agent (Emilio) — conversational driver engagement
NEMOTRON_COMPANION_MODEL=nvidia/llama-3_3-nemotron-super-49b-v1_5

# Perception Agent / VLM (Caleb) — direct frame fatigue analysis
NEMOTRON_VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ── OpenClaw ─────────────────────────────────────────────────────────────────
OPENCLAW_API_KEY=your-openclaw-key-here

# ── Vision ───────────────────────────────────────────────────────────────────
CAMERA_INDEX=0
ANALYSIS_WINDOW_SEC=2

# ── Driver / shift ───────────────────────────────────────────────────────────
DRIVER_ID=your-name-here

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=./safeshift.db

# ── Driver notifications (ntfy) ──────────────────────────────────────────────
# Install ntfy app → subscribe to your topic → paste it here
# Keep NTFY_TOPIC private — treat it like a password
NTFY_TOPIC=safeshift-your-unique-topic
NTFY_SERVER=https://ntfy.sh
ALERT_ENDPOINT=http://localhost:8080/alert
