# Copy this file to .env and fill in real values. Never commit .env.

# NVIDIA / Nemotron
NEMOTRON_API_KEY=your_nemotron_api_key_here
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenClaw agent framework
OPENCLAW_API_KEY=your_openclaw_api_key_here

# Vision
CAMERA_INDEX=0          # 0 = default webcam; set to RTSP URL for IP camera
ANALYSIS_WINDOW_SEC=2   # how many seconds to average per FrameAnalysis

# Driver / shift
DRIVER_ID=driver_001

# Storage — all data stays local; no external upload
DB_PATH=./safeshift.db

# Driver notifications (ntfy.sh recommended: self-hostable, no third-party retention)
# To receive alerts on your phone: install the ntfy app, subscribe to your topic.
NTFY_TOPIC=safeshift-alerts          # unique per driver; keep this private
NTFY_SERVER=https://ntfy.sh          # set to your own ntfy server for full data control
ALERT_ENDPOINT=http://localhost:8080/alert  # on-device alert (audio/visual, demo fallback)
